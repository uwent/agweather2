{
  "name": "agweather2",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@inertiajs/core": "^3.11.0",
    "@playwright/test": "~1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pyright": "^1.1.408",
    "svelte-check": "^4.7.8",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json --config ./svelte.config.js && tsc -p tsconfig.node.json",
    "typecheck:py": "pyright",
    "test": "vitest run",
    "build": "vite build",
    "format": "prettier --write frontend e2e scripts content packages/agmodels/src *.ts *.js",
    "format:check": "prettier --check frontend e2e scripts content packages/agmodels/src *.ts *.js",
    "prepare": "husky",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/red-hat-display": "^5.3.0",
    "@fontsource-variable/red-hat-text": "^5.3.0",
    "@inertiajs/svelte": "^3.11.0",
    "@inertiajs/vite": "^3.11.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "bits-ui": "^2.22.0",
    "echarts": "^6.1.0",
    "maplibre-gl": "^6.19.0",
    "svelte": "^5.59.1",
    "tailwindcss": "^4.3.5"
  },
  "lint-staged": {
    "*.{svelte,ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json}": "prettier --write",
    "*.py": [
      "uv run ruff format",
      "uv run ruff check --fix"
    ],
    "{content/topics,content/pages,packages/agmodels/src/agmodels/models,packages/agmodels/src/agmodels/insects}/*.md": [
      "uv run python scripts/stamp_updated.py",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.10.1"
}
