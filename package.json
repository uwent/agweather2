{
  "name": "agweather2",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@inertiajs/core": "^3.8.0",
    "@playwright/test": "1.63",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pyright": "^1.1.408",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "typecheck:py": "pyright",
    "test": "vitest run",
    "build": "vite build",
    "format": "prettier --write frontend e2e scripts *.ts *.js",
    "format:check": "prettier --check frontend e2e scripts *.ts *.js",
    "prepare": "husky",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/red-hat-display": "^5.3.0",
    "@fontsource-variable/red-hat-text": "^5.3.0",
    "@inertiajs/svelte": "^3.8.0",
    "@inertiajs/vite": "^3.8.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.4",
    "echarts": "^6.1.0",
    "maplibre-gl": "^6.11.2",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3"
  },
  "lint-staged": {
    "*.{svelte,ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json}": "prettier --write",
    "*.py": [
      "uv run ruff format",
      "uv run ruff check --fix"
    ]
  },
  "packageManager": "pnpm@12.10.1"
}
