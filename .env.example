# Copy to .env for development; every value has a working default
# DATABASE_URL=postgres://postgres:password@localhost:5432/agweather2_development
# Where the Zarr archive and GRIB scratch live (gitignored)
# DATA_DIR=data
# Service box: a preset (wisconsin, upper_midwest, conus) or south,west,north,east in degrees
# SERVICE_BOX=wisconsin
# Worker processes for jobs over the grid's blocks (rollup, running totals, ingredients; agdata.blocks), a few GB each
# BLOCK_WORKERS=1
# Memory limits of the web and worker containers (infra/compose.yaml): a runaway request or job stays inside its own
# WEB_MEMORY=12g
# WORKER_MEMORY=32g
# Open-Meteo customer key (needed from Phase 4; blank uses the free API)
# OPEN_METEO_API_KEY=
# COPERNICUS_API_KEY=  # the Copernicus CDS's personal access token, for ERA5-Land (accept its licence first)
