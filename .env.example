# Copy to .env for development; every value has a working default
# DATABASE_URL=postgres://postgres:password@localhost:5432/agweather2_development
# Where the Zarr archive and GRIB scratch live (gitignored)
# DATA_DIR=data
# Service box as south,west,north,east in degrees (Upper Midwest)
# SERVICE_BOX=35,-100,50,-75
# Open-Meteo customer key (needed from Phase 4; blank uses the free API)
# OPEN_METEO_API_KEY=
