# Copy to .env for development; every value has a working default
# DATABASE_URL=postgres://postgres:password@localhost:5432/agweather2_development
# Where the Zarr archive and GRIB scratch live (gitignored)
# DATA_DIR=data
# Service box: a preset (wisconsin, upper_midwest, conus) or south,west,north,east in degrees
# SERVICE_BOX=wisconsin
# Worker processes for jobs over the grid's blocks (rollup, running totals, ingredients; agdata.blocks), a few GB each
# BLOCK_WORKERS=1
# Memory limits of the web and worker containers (infra/compose.yaml): a runaway request or job stays inside its own
# WEB_MEMORY=12g
# WORKER_MEMORY=32g
# Open-Meteo customer key (needed from Phase 4; blank uses the free API)
# OPEN_METEO_API_KEY=
# The plan the app's use is measured against (D115; defaults: 5,000,000 a month renewing on the 12th with a key,
# the free API's 300,000 a month and 10,000 a day without)
# OPEN_METEO_MONTHLY_CALLS=
# OPEN_METEO_DAILY_CALLS=
# OPEN_METEO_BILLING_DAY=12
# COPERNICUS_API_KEY=  # the Copernicus CDS's personal access token, for ERA5-Land (accept its licence first)
# Points in the box take Open-Meteo's forecast while ours is stale or missing (D114); 0 turns it off
# OPEN_METEO_FALLBACK=1
# The API's rate limit, units a minute per client (D69), and its time limit in seconds (0: none)
# API_RATE_LIMIT=200
# API_TIME_LIMIT=30
# A client with this many requests still running past the time limit is refused until one finishes (0: no cap)
# API_OVERRUN_LIMIT=2
# Large computations (maps computed on request, long ranges over large areas) run this many at a time per web
# process; another waits this many seconds for a turn, then is answered 503 (0 slots: no limit)
# API_HEAVY_SLOTS=1
# API_HEAVY_WAIT=5
