# SITE_ADDRESS is the public hostname in production (Caddy gets its certificate), or :80 for plain HTTP locally
{$SITE_ADDRESS}

encode zstd gzip

# Collected static files, including the Vite build, which has hashed names and never changes
handle_path /static/* {
	root * /srv/static
	@hashed path /vite/assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	file_server
}

# The yearly NetCDF downloads (ops.downloads), built by the worker in the data volume; rebuilt in place, so clients
# revalidate (Caddy sends an ETag and Last-Modified)
handle_path /downloads/* {
	root * /srv/data/downloads
	@netcdf path *.nc
	header @netcdf Content-Type application/x-netcdf
	header Cache-Control "public, no-cache"
	file_server
}

handle {
	reverse_proxy web:8000
}
