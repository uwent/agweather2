# SITE_ADDRESS is the public hostname in production (Caddy gets its certificate), or :80 for plain HTTP locally
{$SITE_ADDRESS}

encode zstd gzip

# v1's API (D62): every /api/ path outside /api/v2 goes to v1 on the legacy host for the year it stays up, with its
# path and query and keeping its method (308); bare /api goes to v2's docs. v1's and VDIFN's pages are Django's
# (web.legacy), which also answers these where Caddy isn't in front.
@legacy_api {
	path /api/*
	not path /api/ /api/v2 /api/v2/*
}
redir @legacy_api {$LEGACY_HOST:https://legacy.agweather.cals.wisc.edu}{uri} 308
redir /api /api/v2/docs
redir /api/ /api/v2/docs

# Collected static files, including the Vite build, which has hashed names and never changes
handle_path /static/* {
	root * /srv/static
	@hashed path /vite/assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	file_server
}

# Browsers ask for /favicon.ico wherever a page doesn't link an icon (the API docs, a JSON answer)
handle /favicon.ico {
	root * /srv/static
	header Cache-Control "public, max-age=86400"
	file_server
}

# The yearly NetCDF downloads (ops.downloads), built by the worker in the data volume; rebuilt in place, so clients
# revalidate (Caddy sends an ETag and Last-Modified)
handle_path /downloads/* {
	root * /srv/data/downloads
	@netcdf path *.nc
	header @netcdf Content-Type application/x-netcdf
	header Cache-Control "public, no-cache"
	file_server
}

# The outer bound on a request: the API answers its own past API_TIME_LIMIT (30 s, api.timelimit), so this is for a
# process too stuck to answer at all, and for pages
handle {
	reverse_proxy web:8000 {
		transport http {
			response_header_timeout 45s
		}
	}
}

# When the app can't answer (stuck past the bound above, or restarting), the API's clients still get its envelope
handle_errors {
	@api path /api/*
	handle @api {
		header Content-Type application/json
		header Cache-Control no-store
		header Retry-After 120
		respond `{"meta":{"api_version":"2.0"},"errors":[{"code":"unavailable","param":null,"message":"We couldn't answer this request just now: the service is busy or restarting. Please try again in a few minutes."}]}` {err.status_code}
	}
}
